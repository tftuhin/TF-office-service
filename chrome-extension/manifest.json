{
  "manifest_version": 3,
  "name": "Themefisher Quick Order",
  "description": "Place orders in 2-3 clicks",
  "version": "1.0.1",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://tf-office-service.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Themefisher Quick Order"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tf-office-service.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
